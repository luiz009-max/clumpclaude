# Copie para .env (local) e cadastre as MESMAS variáveis na Vercel:
# Project Settings > Environment Variables (Production + Preview), depois faça Redeploy.

# --- Públicas (vão para o navegador; precisam existir no BUILD) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_ou_anon_key

# --- Somente servidor (NUNCA use prefixo VITE_ nesta) ---
# Supabase > Project Settings > API > service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=
